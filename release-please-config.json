{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": true,
  "bump-minor-pre-major": true,
  "initial-version": "0.1.0",
  "separate-pull-requests": false,
  "plugins": [
    {
      "type": "node-workspace"
    }
  ],
  "packages": {
    "packages/core": {
      "component": "core",
      "release-as": "0.1.1"
    },
    "packages/board": {
      "component": "board",
      "release-as": "0.1.1"
    },
    "packages/dispatch": {
      "component": "dispatch",
      "release-as": "0.1.1"
    },
    "packages/spec": {
      "component": "spec",
      "release-as": "0.1.1"
    },
    "packages/agents": {
      "component": "agents",
      "release-as": "0.1.1"
    }
  }
}
