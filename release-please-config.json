{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": true,
  "bump-minor-pre-major": true,
  "separate-pull-requests": false,
  "plugins": [
    {
      "type": "node-workspace"
    }
  ],
  "packages": {
    "packages/core": {
      "component": "core"
    },
    "packages/board": {
      "component": "board"
    },
    "packages/dispatch": {
      "component": "dispatch"
    },
    "packages/spec": {
      "component": "spec"
    },
    "packages/agents": {
      "component": "agents"
    }
  }
}
