{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": true,
  "bump-minor-pre-major": true,
  "initial-version": "0.1.0",
  "separate-pull-requests": false,
  "plugins": [
    {
      "type": "node-workspace"
    }
  ],
  "packages": {
    "packages/core": {
      "component": "core"
    },
    "packages/board": {
      "component": "board"
    },
    "packages/dispatch": {
      "component": "dispatch",
      "release-as": "0.1.0",
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance Improvements"
        },
        {
          "type": "refactor",
          "section": "Code Refactoring"
        }
      ]
    },
    "packages/spec": {
      "component": "spec"
    },
    "packages/agents": {
      "component": "agents"
    }
  }
}
