{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": true,
  "bump-minor-pre-major": true,
  "separate-pull-requests": false,
  "plugins": [
    {
      "type": "node-workspace"
    }
  ],
  "packages": {
    "packages/github": {
      "component": "github"
    },
    "packages/cli": {
      "component": "cli"
    },
    "packages/policy": {
      "component": "policy"
    },
    "packages/tracker": {
      "component": "tracker"
    },
    "packages/delivery": {
      "component": "delivery"
    },
    "packages/spec-parser": {
      "component": "spec-parser"
    },
    "packages/spec-to-issues": {
      "component": "spec-to-issues"
    },
    "packages/agents": {
      "component": "agents"
    },
    "packages/workflow-lint": {
      "component": "workflow-lint"
    }
  }
}
