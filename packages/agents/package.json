{
  "name": "@agenticool/agents",
  "version": "0.0.0",
  "description": "Shared Claude Code and Codex agents and skills, the generator that renders them for a repository, the review publisher, and the sync that keeps a repository's board files and shared agent rules current.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.mjs",
    "./defaults.json": "./defaults.json"
  },
  "bin": {
    "agenticool-agents": "./bin/agenticool-agents.mjs"
  },
  "files": [
    "bin",
    "defaults.json",
    "sources",
    "src",
    "templates"
  ],
  "engines": {
    "node": ">=24.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticool/agenticool.git",
    "directory": "packages/agents"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@agenticool/board": "^0.0.0",
    "@agenticool/core": "^0.0.0",
    "yaml": "^2.9.1"
  }
}
