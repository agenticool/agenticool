{
  "name": "@agenticool/spec-parser",
  "version": "0.0.0",
  "description": "Parse a specification written to the spec-slicing format, check its pre-flight rules, and render every issue body offline.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "src",
    "bin",
    "spec-slicing.md",
    "body-shapes.md",
    "fixtures"
  ],
  "bin": {
    "agenticool-spec": "bin/agenticool-spec.mjs"
  },
  "engines": {
    "node": ">=24.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenticool/agenticool.git",
    "directory": "packages/spec-parser"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "@agenticool/cli": "^0.0.0",
    "@agenticool/policy": "^0.0.0"
  }
}
