{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent workflow policy (.agents/policy.json)",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "binding": {
      "description": "Repository facts every agent source and script reads.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "description": "Prefix of every agent and skill name, without the trailing dash.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*$"
        },
        "label": { "type": "string", "minLength": 1 },
        "repository": {
          "description": "owner/name of the GitHub repository.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "project": {
          "description": "The GitHub Projects v2 board that tracks delivery.",
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "number", "name"],
          "properties": {
            "owner": { "type": "string", "minLength": 1 },
            "ownerType": {
              "description": "Whether the project owner is a user or an organization.",
              "enum": ["user", "organization"],
              "default": "user"
            },
            "number": { "type": "integer", "minimum": 1 },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "tokenEnv": {
          "description": "Environment variable that holds the Projects token.",
          "type": "string",
          "pattern": "^[A-Z_][A-Z0-9_]*$"
        },
        "docs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["triage", "workflow", "guides"],
          "properties": {
            "triage": { "type": "string", "minLength": 1 },
            "workflow": { "type": "string", "minLength": 1 },
            "guides": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "infrastructure": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accountChecks": {
              "description": "Files that hold the cloud account checks the security reviewer inspects.",
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "features": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "infrastructure": { "type": "boolean" },
            "releasePlease": {
              "description": "Release pull requests get package labels.",
              "type": "boolean",
              "default": false
            },
            "browserMcp": {
              "description": "Sync writes project MCP configuration for browser tools.",
              "type": "boolean",
              "default": false
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claude", "codex"],
        "properties": {
          "summary": { "type": "string" },
          "claude": { "$ref": "#/$defs/setting" },
          "codex": { "$ref": "#/$defs/setting" }
        }
      }
    },
    "roles": {
      "description": "Role name to the capability whose settings it uses.",
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "supported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claude", "codex"],
      "properties": {
        "claude": { "$ref": "#/$defs/support" },
        "codex": { "$ref": "#/$defs/support" }
      }
    },
    "implementationEffort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "automaticMaximum",
        "maximumTransitions",
        "rules"
      ],
      "properties": {
        "default": { "type": "string", "minLength": 1 },
        "automaticMaximum": { "type": "string", "minLength": 1 },
        "maximumTransitions": { "type": "integer", "minimum": 0 },
        "assessmentOrder": { "$ref": "#/$defs/strings" },
        "blockers": { "$ref": "#/$defs/strings" },
        "nonTriggers": { "$ref": "#/$defs/strings" },
        "rules": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["description", "requires"],
            "properties": {
              "description": { "type": "string" },
              "requires": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "extra": {
          "description": "Repository-only labels merged over the base catalog.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "color", "description"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "color": { "type": "string", "pattern": "^[0-9a-fA-F]{6}$" },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "local": {
      "description": "Repository-only agent sources.",
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "roles": {
          "type": "string",
          "minLength": 1,
          "default": ".agents/local/roles"
        },
        "workflows": {
          "type": "string",
          "minLength": 1,
          "default": ".agents/local/workflows"
        }
      }
    }
  },
  "$defs": {
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "effort"],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "effort": { "type": "string", "minLength": 1 }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["models"],
      "properties": {
        "description": { "type": "string" },
        "modelIdPattern": { "type": "string", "minLength": 1 },
        "models": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "strings": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
